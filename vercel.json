{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "bmxcolorado.com" }],
      "destination": "https://www.bmxcolorado.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "coloradobmx.com" }],
      "destination": "https://www.bmxcolorado.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.coloradobmx.com" }],
      "destination": "https://www.bmxcolorado.com/:path*",
      "permanent": true
    }
  ]
}
